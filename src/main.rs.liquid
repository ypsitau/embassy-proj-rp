struct HidRequestHandler {
    hid_protocol_mode: atomic::AtomicU8,
}

impl HidRequestHandler {
    fn new() -> Self {
        HidRequestHandler {
            hid_protocol_mode: atomic::AtomicU8::new(emb::usb::class::hid::HidProtocolMode::Boot as u8),
        }
    }
}

impl emb::usb::class::hid::RequestHandler for HidRequestHandler {
    // Reads the value of report `id` into `buf` returning the size.
    // Returns `None` if `id` is invalid or no data is available.
    fn get_report(&mut self, id: emb::usb::class::hid::ReportId, _buf: &mut [u8]) -> Option<usize> {
        info!("hid::RequestHander.get_report(id: {:?})", id);
        None
    }
    // Sets the value of report `id` to `data`.
    fn set_report(&mut self, id: emb::usb::class::hid::ReportId, data: &[u8]) -> emb::usb::control::OutResponse {
        info!("hid::RequestHandler.set_report(id: {:?}, data: {:02x}", id, data);
        emb::usb::control::OutResponse::Accepted
    }
    // Gets the current hid protocol.
    // Returns `Report` protocol by default.
    fn get_protocol(&self) -> emb::usb::class::hid::HidProtocolMode {
        let mode = emb::usb::class::hid::HidProtocolMode::from(self.hid_protocol_mode.load(atomic::Ordering::Relaxed));
        info!("hid::RequestHandler.get_protocol() -> {}", mode);
        mode
    }
    // Sets the current hid protocol to `protocol`.
    // Accepts only `Report` protocol by default.
    fn set_protocol(&mut self, protocol: emb::usb::class::hid::HidProtocolMode) -> emb::usb::control::OutResponse {
        info!("hid::RequestHandler.set_protocol(protocol: {})", protocol);
        self.hid_protocol_mode.store(protocol as u8, atomic::Ordering::Relaxed);
        emb::usb::control::OutResponse::Accepted
    }
    // Get the idle rate for `id`.
    // If `id` is `None`, get the idle rate for all reports. Returning `None`
    // will reject the control request. Any duration at or above 1.024 seconds
    // or below 4ms will be returned as an indefinite idle rate.
    fn get_idle_ms(&mut self, id: Option<emb::usb::class::hid::ReportId>) -> Option<u32> {
        info!("hid::RequestHandler.get_idle_ms(id: {:?})", id);
        None
    }
    // Set the idle rate for `id` to `dur`.
    // If `id` is `None`, set the idle rate of all input reports to `dur`. If
    // an indefinite duration is requested, `dur` will be set to `u32::MAX`.
    fn set_idle_ms(&mut self, id: Option<emb::usb::class::hid::ReportId>, dur: u32) {
        info!("hid::RequestHandler.set_idle_ms(id: {:?}, dur: {:?})", id, dur);
    }
}
{%- when "I2C SSD1306" -%}
//! I2C SSD1306 example using Embassy and async/await.
//!
//! ## Pin Assignment
//!
//! | Raspberry Pi Pico | SSD1306 |
//! |-------------------|---------|
//! | GPIO16            | SDA     |
//! | GPIO17            | SCL     |
#![no_std]
#![no_main]

mod emb {
    pub use embassy_executor as executor;
    pub use embassy_embedded_hal::shared_bus;
    pub use embassy_sync as sync;
    pub use embassy_time as time;
}
use embedded_hal_async as hal_async;

use core::fmt::Write as _;
use defmt::info;
use heapless::String;
use static_cell::StaticCell;
use {defmt_rtt as _, panic_probe as _};

use embassy_rp as rp;

rp::bind_interrupts!(struct Irqs {
    I2C0_IRQ => rp::i2c::InterruptHandler<rp::peripherals::I2C0>;
});

#[emb::executor::main]
async fn main(_spawner: emb::executor::Spawner) {
    let (i2c_ssd1306,) = {
        let p = rp::init(Default::default());
        let mutex_i2c0 = {
            let pin_sda = p.PIN_16;
            let pin_scl = p.PIN_17;
            let mut config = rp::i2c::Config::default();
            config.frequency = 400_000;
            let i2c0 = rp::i2c::I2c::new_async(p.I2C0, pin_scl, pin_sda, Irqs, config);
            static STATIC_CELL: StaticCell<emb::sync::mutex::Mutex<
                emb::sync::blocking_mutex::raw::NoopRawMutex,
                rp::i2c::I2c<'static, rp::peripherals::I2C0, rp::i2c::Async>>> = StaticCell::new();
            STATIC_CELL.init(emb::sync::mutex::Mutex::new(i2c0))
        };
        let i2c_ssd1306 = emb::shared_bus::asynch::i2c::I2cDevice::new(mutex_i2c0);
        (i2c_ssd1306,)
    };
    let fut_task_display = task_display(i2c_ssd1306);
    fut_task_display.await;
}

async fn task_display(i2c_ssd1306: impl hal_async::i2c::I2c) {
    info!("Starting display task");
    use ssd1306::prelude::*;
    use embedded_graphics as eg;
    use embedded_graphics::prelude::*;
    enum Direction { Inc, Dec }
    impl Direction {
        fn step(&self, value: &mut i32) {
            *value += match self { Self::Inc => 1, Self::Dec => -1 };
        }
    }
    let mut display = {
        let interface = ssd1306::I2CDisplayInterface::new(i2c_ssd1306);
        let size = ssd1306::size::DisplaySize128x64;
        let rotation = ssd1306::rotation::DisplayRotation::Rotate0;
        ssd1306::Ssd1306Async::new(interface, size, rotation).into_buffered_graphics_mode()
    };
    display.init().await.unwrap();
    let text_style = eg::mono_font::MonoTextStyleBuilder::new()
        .font(&eg::mono_font::ascii::FONT_10X20)
        .text_color(eg::pixelcolor::BinaryColor::On)
        .build();
    let mut sbuf: String<16> = String::new();
    let style_dot = eg::primitives::PrimitiveStyleBuilder::new()
        .fill_color(eg::pixelcolor::BinaryColor::On)
        .build();
    let size_display = {
        let (width, height) = display.dimensions();
        Size::new(width as u32, height as u32)
    };
    let size_dot = Size::new(8, 8);
    let mut i_frame = 0;
    let (mut x, mut y) = (size_display.width as i32 / 2, size_display.height as i32 / 2);
    let (mut x_dir, mut y_dir) = (Direction::Inc, Direction::Inc);
    let mut ticker = emb::time::Ticker::every(emb::time::Duration::from_millis(10));
    loop {
        display.clear(eg::pixelcolor::BinaryColor::Off).unwrap();
        sbuf.clear();
        write!(sbuf, "Frame: {}", i_frame).unwrap();
        eg::text::Text::with_baseline(
            sbuf.as_str(), Point::new(0, 0), text_style, eg::text::Baseline::Top
        ).draw(&mut display).unwrap();
        eg::primitives::Rectangle::new(
            Point::new(x, y), size_dot
        ).into_styled(style_dot).draw(&mut display).unwrap();
        i_frame += 1;
        if x >= (size_display.width - size_dot.width) as i32 {
            x_dir = Direction::Dec;
        } else if x <= 0 {
            x_dir = Direction::Inc;
        }
        if y >= (size_display.height - size_dot.height) as i32 {
            y_dir = Direction::Dec;
        } else if y <= 0 {
            y_dir = Direction::Inc;
        }
        x_dir.step(&mut x);
        y_dir.step(&mut y);
        display.flush().await.unwrap();
        ticker.next().await;
    }
}
{%- when "Wi-Fi HTTP Client" -%}
#![no_std]
#![no_main]

mod emb {
    pub use embassy_executor as executor;
    pub use embassy_futures as futures;
    pub use embassy_net as net;
    pub use embassy_time as time;
}

use defmt::*;
use static_cell::StaticCell;
use {defmt_rtt as _, panic_probe as _};

mod private_info;

use embassy_rp as rp;

rp::bind_interrupts!(struct Irqs {
    PIO0_IRQ_0 => rp::pio::InterruptHandler<rp::peripherals::PIO0>;
    DMA_IRQ_0 => rp::dma::InterruptHandler<rp::peripherals::DMA_CH0>;
});

#[embassy_executor::task]
async fn cyw43_task(cyw43_runner: cyw43::Runner<'static, cyw43::SpiBus<rp::gpio::Output<'static>, cyw43_pio::PioSpi<'static, rp::peripherals::PIO0, 0>>>) -> ! {
    cyw43_runner.run().await;
}

#[emb::executor::main]
async fn main(spawner: emb::executor::Spawner) {
    let p = embassy_rp::init(Default::default());
    let (net_driver, mut cyw43_control) =  {
        let (pin_pwr, pin_dio, pin_cs, pin_clk) = (p.PIN_23, p.PIN_24, p.PIN_25, p.PIN_29);
        const PRE_DOWNLOAD_FIRMWARE: bool = true;
        let state = {
            static STATIC_CELL: StaticCell<cyw43::State> = StaticCell::new();
            STATIC_CELL.init(cyw43::State::new())
        };
        let pwr = rp::gpio::Output::new(pin_pwr, rp::gpio::Level::Low);
        let spi = {
            let mut pio = rp::pio::Pio::new(p.PIO0, Irqs);
            let sm = pio.sm0;
            let clock_divider = cyw43_pio::DEFAULT_CLOCK_DIVIDER;
            let irq = pio.irq0;
            let cs = rp::gpio::Output::new(pin_cs, rp::gpio::Level::High);
            let dma = rp::dma::Channel::new(p.DMA_CH0, Irqs);
            cyw43_pio::PioSpi::new(&mut pio.common, sm, clock_divider, irq, cs, pin_dio, pin_clk, dma)
        };
        let (fw, cyw43_clm) = if PRE_DOWNLOAD_FIRMWARE {
            // Use pre-downloaded firmware
            // $ probe-rs download cyw43-firmware/43439A0.bin --binary-format bin --chip RP2040 --base-address 0x10180000
            // $ probe-rs download cyw43-firmware/43439A0_clm.bin --binary-format bin --chip RP2040 --base-address 0x101c0000
            let fw = unsafe {
                &*(core::ptr::slice_from_raw_parts(0x10180000 as *const u8, 231077)
                    as *const cyw43::Aligned<cyw43::A4, [u8]>)
            };
            let cyw43_clm = unsafe {
                &*(core::ptr::slice_from_raw_parts(0x101c0000 as *const u8, 984)
                    as *const cyw43::Aligned<cyw43::A4, [u8]>)
            };
            (fw, cyw43_clm)
        } else {
            let fw = cyw43::aligned_bytes!("../cyw43-firmware/43439A0.bin");
            let cyw43_clm = cyw43::aligned_bytes!("../cyw43-firmware/43439A0_clm.bin");
            (fw, cyw43_clm)
        };
        let nvram = cyw43::aligned_bytes!("../cyw43-firmware/nvram_rp2040.bin");
        let (net_driver, mut cyw43_control, cyw43_runner) = cyw43::new(state, pwr, spi, fw, nvram).await;
        spawner.spawn(cyw43_task(cyw43_runner).unwrap());
        cyw43_control.init(cyw43_clm).await;
        cyw43_control.set_power_management(cyw43::PowerManagementMode::PowerSave).await;
        let ssid = private_info::WIFI_SSID;
        let join_options = cyw43::JoinOptions::new(private_info::WIFI_PASSWORD.as_bytes());
        while let Err(err) = cyw43_control.join(ssid, join_options.clone()).await {
            info!("join failed: {:?}", err);
        }
        (net_driver, cyw43_control)
    };
    let (net_stack, mut net_runner) = {
        const USE_DHCP: bool = true;
        let config = if USE_DHCP {
            emb::net::Config::dhcpv4(Default::default())
        } else {
            let address = emb::net::Ipv4Cidr::new(emb::net::Ipv4Address::new(192, 168, 0, 100), 24);
            let mut dns_servers = heapless::Vec::<emb::net::Ipv4Address, 3>::new();
            dns_servers.push(emb::net::Ipv4Address::new(192, 168, 0, 1)).unwrap();
            let gateway = Some(emb::net::Ipv4Address::new(192, 168, 0, 1));
            emb::net::Config::ipv4_static(emb::net::StaticConfigV4 {address, dns_servers, gateway})
        };
        let resources = {
            static STATIC_CELL: StaticCell<emb::net::StackResources<3>> = StaticCell::new();
            STATIC_CELL.init(emb::net::StackResources::new())
        };
        let mut rng = rp::clocks::RoscRng;
        let seed = rng.next_u64();
        let (net_stack, net_runner) = emb::net::new(net_driver, config, resources, seed);
        (net_stack, net_runner)
    };
    let fut_net_runner = net_runner.run();
    let fut_main = async {
        info!("waiting for link...");
        net_stack.wait_link_up().await;
        info!("waiting for DHCP...");
        net_stack.wait_config_up().await;
        info!("Stack is up!");
        run_http_client(net_stack).await;
    };
    let fut_blinky = async {
        loop {
            cyw43_control.gpio_set(0, true).await;
            emb::time::Timer::after_millis(300).await;
            cyw43_control.gpio_set(0, false).await;
            emb::time::Timer::after_millis(300).await;
        }
    };
    emb::futures::join::join3(fut_main, fut_net_runner, fut_blinky).await;
}

async fn run_http_client(net_stack: emb::net::Stack<'_>) -> ! {
    const USE_TLS: bool = false;
    let client_state = {
        const N: usize = 1;
        const TX_SZ: usize = 4096;
        const RX_SZ: usize = 4096;
        static STATIC_CELL: StaticCell<emb::net::tcp::client::TcpClientState<N, TX_SZ, RX_SZ>> = StaticCell::new();
        STATIC_CELL.init(emb::net::tcp::client::TcpClientState::<N, TX_SZ, RX_SZ>::new())
    };
    let buf_response = {
        const SIZE: usize = 4096;
        static STATIC_CELL: StaticCell<[u8; SIZE]> = StaticCell::new();
        STATIC_CELL.init([0; SIZE])
    };
    loop {
        let tcp_client = emb::net::tcp::client::TcpClient::new(net_stack, client_state);
        let dns_socket = emb::net::dns::DnsSocket::new(net_stack);
        let (mut http_client, url) = if USE_TLS {
            let tls_read_buffer = {
                static STATIC_CELL: StaticCell<[u8; 16640]> = StaticCell::new();
                STATIC_CELL.init([0u8; 16640])
            };
            let tls_write_buffer = {
                static STATIC_CELL: StaticCell<[u8; 16640]> = StaticCell::new();
                STATIC_CELL.init([0u8; 16640])
            };
            let tls_config = {
                let mut rng = rp::clocks::RoscRng;
                let seed = rng.next_u64();
                reqwless::client::TlsConfig::new(seed, tls_read_buffer, tls_write_buffer, reqwless::client::TlsVerify::None)
            };
            let http_client = reqwless::client::HttpClient::new_with_tls(&tcp_client, &dns_socket, tls_config);
            let url = "https://httpbin.org/json";
            (http_client, url)
        } else {
            let http_client = reqwless::client::HttpClient::new(&tcp_client, &dns_socket);
            let url = "http://httpbin.org/json";
            (http_client, url)
        };
        info!("connecting to {}", &url);
        let mut request = match http_client.request(reqwless::request::Method::GET, url).await {
            Ok(request) => request,
            Err(e) => {
                error!("Failed to make HTTP request: {:?}", e);
                emb::time::Timer::after_secs(5).await;
                continue;
            }
        };
        let response = match request.send(buf_response).await {
            Ok(response) => response,
            Err(e) => {
                error!("Failed to send HTTP request: {:?}", e);
                emb::time::Timer::after_secs(5).await;
                continue;
            }
        };
        info!("Response status: {}", response.status.0);
        let body_bytes = match response.body().read_to_end().await {
            Ok(body_bytes) => body_bytes,
            Err(_e) => {
                error!("Failed to read response body");
                emb::time::Timer::after_secs(5).await;
                continue;
            }
        };
        info!("Response body length: {} bytes", body_bytes.len());
        #[derive(serde::Deserialize)]
        struct SlideShow<'a> {
            author: &'a str,
            title: &'a str,
        }
        #[derive(serde::Deserialize)]
        struct HttpBinResponse<'a> {
            #[serde(borrow)]
            slideshow: SlideShow<'a>,
        }
        match serde_json_core::from_slice::<HttpBinResponse>(body_bytes) {
            Ok((output, _used)) => {
                info!("Successfully parsed JSON response!");
                info!("Slideshow title: {:?}", output.slideshow.title);
                info!("Slideshow author: {:?}", output.slideshow.author);
            }
            Err(e) => {
                error!("Failed to parse JSON response: {}", Debug2Format(&e));
            }
        }
        emb::time::Timer::after_secs(5).await;
    }
}
