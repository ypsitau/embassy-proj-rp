{%- when "Blinky" -%}
//! Blinky example using Embassy and async/await.
#![no_std]
#![no_main]

mod emb {
    pub use embassy_executor as executor;
    pub use embassy_time as time;
}
use embedded_hal_1 as hal;

use defmt::info;
use {defmt_rtt as _, panic_probe as _};

use embassy_rp as rp;

#[emb::executor::main]
async fn main(_spawner: emb::executor::Spawner) {
    let (pin_led,) = {
        let p = rp::init(Default::default());
        let pin_led = p.PIN_25;
        let pin_led = rp::gpio::Output::new(pin_led, rp::gpio::Level::Low);
        (pin_led,)
    };
    let fut_task_blinky = task_blinky(pin_led);
    fut_task_blinky.await;
}

async fn task_blinky(mut pin_led: impl hal::digital::OutputPin)
{
    info!("Starting task_blinky");
    let mut ticker = emb::time::Ticker::every(emb::time::Duration::from_millis(500));
    loop {
        pin_led.set_high().ok();
        ticker.next().await;
        pin_led.set_low().ok();
        ticker.next().await;
    }
}
{%- when "GPIO In/Out" -%}
//! GPIO In/Out example using Embassy and async/await.
//!
//! ## Pin Assignment
//! | Raspberry Pi Pico | Function |
//! |-------------------|----------|
//! | GPIO15            | Switch to GND  |
#![no_std]
#![no_main]

mod emb {
    pub use embassy_executor as executor;
    pub use embassy_time as time;
}
use embedded_hal_1 as hal;
use embedded_hal_async as hal_async;

use defmt::info;
use {defmt_rtt as _, panic_probe as _};

use embassy_rp as rp;

#[emb::executor::main]
async fn main(_spawner: emb::executor::Spawner) {
    let (pin_sw, pin_led) = {
        let p = rp::init(Default::default());
        let (pin_sw, pin_led) = (p.PIN_15, p.PIN_25);
        let pin_sw = rp::gpio::Input::new(pin_sw, rp::gpio::Pull::Up);
        let pin_led = rp::gpio::Output::new(pin_led, rp::gpio::Level::Low);
        (pin_sw, pin_led)
    };
    let fut_task_pin_in_out = task_pin_in_out(pin_sw, pin_led);
    fut_task_pin_in_out.await;
}

async fn task_pin_in_out<InputPin, OutputPin>(mut pin_sw: InputPin, mut pin_led: OutputPin)
where
    InputPin: hal::digital::InputPin + hal_async::digital::Wait,
    OutputPin: hal::digital::OutputPin,
{
    info!("Starting task_pin_in_out");
    loop {
        let is_pushed = pin_sw.is_low().unwrap();
        if is_pushed {
            info!("Button pressed");
            pin_led.set_high().ok();
        } else {
            info!("Button released");
            pin_led.set_low().ok();
        }
        pin_sw.wait_for_any_edge().await.ok();
        emb::time::Timer::after_millis(30).await;    // debounce delay
    }
}
{%- when "UART Echo" -%}
//! UART Echo example using Embassy and async/await.
//!
//! ## Pin Assignment
//! | Raspberry Pi Pico | Function |
//! |------------------|----------|
//! | GPIO0            | UART TX  |
//! | GPIO1            | UART RX  |
#![no_std]
#![no_main]

mod emb {
    pub use embassy_executor as executor;
}
use embedded_io_async as io_async;

use defmt::info;
use static_cell::StaticCell;
use {defmt_rtt as _, panic_probe as _};

use embassy_rp as rp;

rp::bind_interrupts!(struct Irqs {
    UART0_IRQ => rp::uart::BufferedInterruptHandler<rp::peripherals::UART0>;
});

#[emb::executor::main]
async fn main(_spawner: emb::executor::Spawner) {
    let p = rp::init(Default::default());
    let (uart_tx, uart_rx) = {
        let pin_tx = p.PIN_0;
        let pin_rx = p.PIN_1;
        let tx_buffer = { // should be replaced by make_static macro when it becomes available
            const TX_BUFFER_SIZE: usize = 64;
            static STATIC_CELL: StaticCell<[u8; TX_BUFFER_SIZE]> = StaticCell::new();
            STATIC_CELL.init([0u8; TX_BUFFER_SIZE])
        };
        let rx_buffer = { // should be replaced by make_static macro when it becomes available
            const RX_BUFFER_SIZE: usize = 64;
            static STATIC_CELL: StaticCell<[u8; RX_BUFFER_SIZE]> = StaticCell::new();
            STATIC_CELL.init([0u8; RX_BUFFER_SIZE])
        };
        let config = rp::uart::Config::default();
        let uart = rp::uart::BufferedUart::new(p.UART0, pin_tx, pin_rx, Irqs, tx_buffer, rx_buffer, config);
        let (uart_tx, uart_rx) = uart.split();
        (uart_tx, uart_rx)
    };
    task_echo(uart_tx, uart_rx).await;
}

async fn task_echo(mut writer: impl io_async::Write, mut reader: impl io_async::Read) -> ! {
    info!("Starting echo task");
    const BUFSIZE: usize = 16;
    let buf = {
        static STATIC_CELL: StaticCell<[u8; BUFSIZE]> = StaticCell::new();
        STATIC_CELL.init([0u8; BUFSIZE])
    };
    writer.write_all(b"Enter any keystrokes:\r\n").await.ok();
    writer.flush().await.ok();
    loop {
        match reader.read(buf).await {
            Ok(len) => {
                writer.write_all(&buf[..len]).await.ok();
                writer.flush().await.ok();
            }
            Err(_) => {
                writer.write_all(b"error in reading\r\n").await.ok();
                writer.flush().await.ok();
            }
        }
    }
}
{%- when "USB Device CDC" -%}
//! USB Device CDC example using Embassy and async/await.
#![no_std]
#![no_main]

mod emb {
    pub use embassy_executor as executor;
    pub use embassy_futures as futures;
    pub use embassy_usb as usb;
}

use core::sync::atomic;
use defmt::info;
use static_cell::StaticCell;
use {defmt_rtt as _, panic_probe as _};

use embassy_rp as rp;

rp::bind_interrupts!(struct Irqs {
    USBCTRL_IRQ => rp::usb::InterruptHandler<rp::peripherals::USB>;
});

#[emb::executor::main]
async fn main(_spawner: emb::executor::Spawner) {
    let (usb_driver,) = {
        let p = rp::init(Default::default());
        let usb_driver = rp::usb::Driver::new(p.USB, Irqs);
        (usb_driver,)
    };
    let fut_task_usb = task_usb(usb_driver);
    fut_task_usb.await;
}

async fn task_usb(usb_driver: impl emb::usb::driver::Driver<'static>) {
    let mut usb_builder = {
        const VID: u16 = 0xc0de;
        const PID: u16 = 0xcafe;
        const CONFIG_DESCRIPTOR_SIZE: usize = 256;
        const BOS_DESCRIPTOR_SIZE: usize = 256;
        const MSOS_DESCRIPTOR_SIZE: usize = 256;
        const CONTROL_BUF_SIZE: usize = 64;
        let mut usb_config = emb::usb::Config::new(VID, PID);
        usb_config.manufacturer = Some("Embassy");
        usb_config.product = Some("hoge");
        usb_config.serial_number = Some("12345678");
        usb_config.max_power = 100;
        usb_config.max_packet_size_0 = CONTROL_BUF_SIZE as u8;
        let config_descriptor_buf = {
            static STATIC_CELL: StaticCell<[u8; CONFIG_DESCRIPTOR_SIZE]> = StaticCell::new();
            STATIC_CELL.init([0u8; CONFIG_DESCRIPTOR_SIZE])
        };
        let bos_descriptor_buf = {
            static STATIC_CELL: StaticCell<[u8; BOS_DESCRIPTOR_SIZE]> = StaticCell::new();
            STATIC_CELL.init([0u8; BOS_DESCRIPTOR_SIZE])
        };
        let msos_descriptor_buf = {
            static STATIC_CELL: StaticCell<[u8; MSOS_DESCRIPTOR_SIZE]> = StaticCell::new();
            STATIC_CELL.init([0u8; MSOS_DESCRIPTOR_SIZE])
        };
        let control_buf = {
            static STATIC_CELL: StaticCell<[u8; CONTROL_BUF_SIZE]> = StaticCell::new();
            STATIC_CELL.init([0u8; CONTROL_BUF_SIZE])
        };
        let usb_handler = {
            static STATIC_CELL: StaticCell<USBHandler> = StaticCell::new();
            STATIC_CELL.init(USBHandler::new())
        };
        let mut usb_builder = emb::usb::Builder::new(usb_driver, usb_config,
            config_descriptor_buf, bos_descriptor_buf, msos_descriptor_buf, control_buf);
        usb_builder.handler(usb_handler);
        usb_builder
    };
    let cdc_driver = {
        let state = {
            static STATE: StaticCell<emb::usb::class::cdc_acm::State> = StaticCell::new();
            STATE.init(emb::usb::class::cdc_acm::State::new())
        };
        let max_packet_size = 64;
        emb::usb::class::cdc_acm::CdcAcmClass::new(&mut usb_builder, state, max_packet_size)
    };
    let mut usb_device = usb_builder.build();
    let fut_usb = usb_device.run();
    let fut_echo = async {
        let (mut cdc_sender, mut cdc_receiver) = cdc_driver.split();
        let buf = {
            static STATIC_CELL: StaticCell<[u8; 64]> = StaticCell::new();
            STATIC_CELL.init([0u8; 64])
        };
        loop {
            cdc_receiver.wait_connection().await;
            info!("Connected");
            let e = loop {
                let buf_read = match cdc_receiver.read_packet(buf).await {
                    Ok(n) => &buf[..n], Err(e) => break e,
                };
                if let Err(e) = cdc_sender.write_packet(buf_read).await { break e; }
            };
            if e != emb::usb::driver::EndpointError::Disabled { break; }
        };
    };
    emb::futures::join::join(fut_usb, fut_echo).await;
}

struct USBHandler {
    configured: atomic::AtomicBool,
}

impl USBHandler {
    fn new() -> Self {
        USBHandler { configured: atomic::AtomicBool::new(false), }
    }
}

impl emb::usb::Handler for USBHandler {
    /// Called when the USB device has been enabled or disabled.
    fn enabled(&mut self, enabled: bool) {
        info!("usb::Handler.enabled({})", enabled);
        self.configured.store(false, atomic::Ordering::Relaxed);
    }
    /// Called after a USB reset after the bus reset sequence is complete.
    fn reset(&mut self) {
        info!("usb::Handler.reset()");
        self.configured.store(false, atomic::Ordering::Relaxed);
    }
    /// Called when the host has set the address of the device to `addr`.
    fn addressed(&mut self, addr: u8) {
        info!("usb::Handler.addressed(addr: {})", addr);
        self.configured.store(false, atomic::Ordering::Relaxed);
    }
    /// Called when the host has enabled or disabled the configuration of the device.
    fn configured(&mut self, configured: bool) {
        info!("usb::Handler.configured(configured: {})", configured);
        self.configured.store(configured, atomic::Ordering::Relaxed);
    }
}
{%- when "USB Device HID Keyboard and Mouse" -%}
//! USB Device HID Keyboard and Mouse example using Embassy and async/await.
#![no_std]
#![no_main]

mod emb {
    pub use embassy_executor as executor;
    pub use embassy_futures as futures;
    pub use embassy_time as time;
    pub use embassy_usb as usb;
}
use embedded_hal_1 as hal;
use embedded_hal_async as hal_async;

use core::sync::atomic;
use defmt::{info, warn};
use static_cell::StaticCell;
use usbd_hid::descriptor::SerializedDescriptor as _;
use {defmt_rtt as _, panic_probe as _};

use embassy_rp as rp;

rp::bind_interrupts!(struct Irqs {
    USBCTRL_IRQ => rp::usb::InterruptHandler<rp::peripherals::USB>;
});

#[emb::executor::main]
async fn main(_spawner: emb::executor::Spawner) {
    let (usb_driver, pin_button_a, pin_button_b, pin_button_left, pin_button_up, pin_button_down, pin_button_right) = {
        let p = rp::init(Default::default());
        let usb_driver = rp::usb::Driver::new(p.USB, Irqs);
        let pin_button_a = rp::gpio::Input::new(p.PIN_16, rp::gpio::Pull::Up);
        let pin_button_b = rp::gpio::Input::new(p.PIN_17, rp::gpio::Pull::Up);
        let pin_button_left = rp::gpio::Input::new(p.PIN_18, rp::gpio::Pull::Up);
        let pin_button_up = rp::gpio::Input::new(p.PIN_19, rp::gpio::Pull::Up);
        let pin_button_down = rp::gpio::Input::new(p.PIN_20, rp::gpio::Pull::Up);
        let pin_button_right = rp::gpio::Input::new(p.PIN_21, rp::gpio::Pull::Up);
        (usb_driver, pin_button_a, pin_button_b, pin_button_left, pin_button_up, pin_button_down, pin_button_right)
    };
    let fut_task_usb = task_usb(usb_driver, pin_button_a, pin_button_b, pin_button_left, pin_button_up, pin_button_down, pin_button_right);
    fut_task_usb.await;
}

async fn task_usb<InputPin>(
    usb_driver: impl emb::usb::driver::Driver<'static>,
    mut pin_button_a: InputPin, mut pin_button_b: InputPin,
    mut pin_button_left: InputPin, mut pin_button_up: InputPin,
    mut pin_button_down: InputPin, mut pin_button_right: InputPin,
)
where
    InputPin: hal::digital::InputPin + hal_async::digital::Wait,
{
    info!("Starting USB task");
    let mut usb_builder = {
        const VID: u16 = 0xc0de;
        const PID: u16 = 0xcafe;
        const CONFIG_DESCRIPTOR_SIZE: usize = 256;
        const BOS_DESCRIPTOR_SIZE: usize = 256;
        const MSOS_DESCRIPTOR_SIZE: usize = 256;
        const CONTROL_BUF_SIZE: usize = 64;
        let mut usb_config = emb::usb::Config::new(VID, PID);
        usb_config.manufacturer = Some("Embassy");
        usb_config.product = Some("hoge");
        usb_config.serial_number = Some("12345678");
        usb_config.max_power = 100;
        usb_config.max_packet_size_0 = CONTROL_BUF_SIZE as u8;
        let config_descriptor_buf = {
            static STATIC_CELL: StaticCell<[u8; CONFIG_DESCRIPTOR_SIZE]> = StaticCell::new();
            STATIC_CELL.init([0u8; CONFIG_DESCRIPTOR_SIZE])
        };
        let bos_descriptor_buf = {
            static STATIC_CELL: StaticCell<[u8; BOS_DESCRIPTOR_SIZE]> = StaticCell::new();
            STATIC_CELL.init([0u8; BOS_DESCRIPTOR_SIZE])
        };
        let msos_descriptor_buf = {
            static STATIC_CELL: StaticCell<[u8; MSOS_DESCRIPTOR_SIZE]> = StaticCell::new();
            STATIC_CELL.init([0u8; MSOS_DESCRIPTOR_SIZE])
        };
        let control_buf = {
            static STATIC_CELL: StaticCell<[u8; CONTROL_BUF_SIZE]> = StaticCell::new();
            STATIC_CELL.init([0u8; CONTROL_BUF_SIZE])
        };
        let usb_handler = {
            static STATIC_CELL: StaticCell<USBHandler> = StaticCell::new();
            STATIC_CELL.init(USBHandler::new())
        };
        let mut usb_builder = emb::usb::Builder::new(usb_driver, usb_config,
            config_descriptor_buf, bos_descriptor_buf, msos_descriptor_buf, control_buf);
        usb_builder.handler(usb_handler);
        usb_builder
    };
    let (hid_keyboard_reader, mut hid_keyboard_writer) = {
        let state = {
            static STATIC_CELL: StaticCell<emb::usb::class::hid::State> = StaticCell::new();
            STATIC_CELL.init(emb::usb::class::hid::State::new())
        };
        let config = emb::usb::class::hid::Config {
            report_descriptor: usbd_hid::descriptor::KeyboardReport::desc(),
            request_handler: None,
            poll_ms: 60,
            max_packet_size: 64,
            hid_subclass: emb::usb::class::hid::HidSubclass::Boot,
            hid_boot_protocol: emb::usb::class::hid::HidBootProtocol::Keyboard,
        };
        emb::usb::class::hid::HidReaderWriter::<_, 1, 8>::new(&mut usb_builder, state, config).split()
    };
    let (hid_mouse_reader, mut hid_mouse_writer) = {
        let state = {
            static STATIC_CELL: StaticCell<emb::usb::class::hid::State> = StaticCell::new();
            STATIC_CELL.init(emb::usb::class::hid::State::new())
        };
        let config = emb::usb::class::hid::Config {
            report_descriptor: usbd_hid::descriptor::MouseReport::desc(),
            request_handler: None,
            poll_ms: 60,
            max_packet_size: 64,
            hid_subclass: emb::usb::class::hid::HidSubclass::Boot,
            hid_boot_protocol: emb::usb::class::hid::HidBootProtocol::Mouse,
        };
        emb::usb::class::hid::HidReaderWriter::<_, 1, 8>::new(&mut usb_builder, state, config).split()
    };
    let mut usb_device = usb_builder.build();
    let fut_usb = usb_device.run();
    let fut_hid_keyboard_writer = async {
        loop {
            let _= emb::futures::select::select_array([
                pin_button_left.wait_for_any_edge(),
                pin_button_up.wait_for_any_edge(),
                pin_button_down.wait_for_any_edge(),
                pin_button_right.wait_for_any_edge(),
            ]).await;
            emb::time::Timer::after_millis(30).await; // skip the bounding period
            let mut n_keycodes = 0;
            let mut keycodes = [0u8; 6];
            if pin_button_left.is_low().unwrap() { keycodes[n_keycodes] = 0x50; n_keycodes += 1; }
            if pin_button_up.is_low().unwrap() { keycodes[n_keycodes] = 0x52; n_keycodes += 1; }
            if pin_button_down.is_low().unwrap() { keycodes[n_keycodes] = 0x51; n_keycodes += 1; }
            if pin_button_right.is_low().unwrap() { keycodes[n_keycodes] = 0x4f; /* n_keycodes += 1; */ }
            let keyboard_report = usbd_hid::descriptor::KeyboardReport {
                modifier: 0,
                reserved: 0,
                leds: 0,
                keycodes,
            };
            info!("Keyboard report: {:?}", keyboard_report.keycodes);
            if let Err(e) = hid_keyboard_writer.write_serialize(&keyboard_report).await {
                warn!("Failed to send report: {:?}", e);
            }
        }
    };
    let fut_hid_mouse_writer = async {
        loop {
            let mouse_report = usbd_hid::descriptor::MouseReport {
                buttons: 0,
                x: 0,
                y: if pin_button_a.is_low().unwrap() {
                    -20
                } else if pin_button_b.is_low().unwrap() {
                    20
                } else {
                    0
                },
                wheel: 0,
                pan: 0,
            };
            if mouse_report.y != 0 {
                info!("Mouse moved: y = {}", mouse_report.y);
            }
            if let Err(e) = hid_mouse_writer.write_serialize(&mouse_report).await {
                warn!("Failed to send report: {:?}", e);
            }
            emb::time::Timer::after_millis(100).await;
        }
    };
    let fut_hid_keyboard_reader = async {
        let mut hid_request_handler = HidRequestHandler::new();
        hid_keyboard_reader.run(false, &mut hid_request_handler).await;
    };
    let fut_hid_mouse_reader = async {
        let mut hid_request_handler = HidRequestHandler::new();
        hid_mouse_reader.run(false, &mut hid_request_handler).await;
    };
    emb::futures::join::join5(fut_usb, fut_hid_keyboard_writer, fut_hid_mouse_writer, fut_hid_keyboard_reader, fut_hid_mouse_reader).await;
}

struct USBHandler {
    configured: atomic::AtomicBool,
}

impl USBHandler {
    fn new() -> Self {
        USBHandler { configured: atomic::AtomicBool::new(false), }
    }
}

impl emb::usb::Handler for USBHandler {
    /// Called when the USB device has been enabled or disabled.
    fn enabled(&mut self, enabled: bool) {
        info!("usb::Handler.enabled({})", enabled);
        self.configured.store(false, atomic::Ordering::Relaxed);
    }
    /// Called after a USB reset after the bus reset sequence is complete.
    fn reset(&mut self) {
        info!("usb::Handler.reset()");
        self.configured.store(false, atomic::Ordering::Relaxed);
    }
    /// Called when the host has set the address of the device to `addr`.
    fn addressed(&mut self, addr: u8) {
        info!("usb::Handler.addressed(addr: {})", addr);
        self.configured.store(false, atomic::Ordering::Relaxed);
    }
