[package]
edition = "2024"
name = "{{project-name}}"
version = "0.1.0"
license = "MIT or Apache-2.0"

[build-dependencies]
regex = { version = "1.11.0" }

[dependencies]
defmt = { version = "1" }
defmt-rtt = { version = "1" }
fixed = { version = "1.29.0" }
heapless = { version = "0.9.3" }
portable-atomic = { version = "1.5", features = ["critical-section"] } # required for static_cell
rand_core = { version = "0.9" }
static_cell = { version = "2" }

embassy-embedded-hal = { version = "0.6.0", features = ["defmt"] }
embassy-executor = { version = "0.10.0", features = ["platform-cortex-m", "executor-thread", "executor-interrupt", "defmt"] }
embassy-futures = { version = "0.1.2" }
embassy-sync = { version = "0.8.0" }
embassy-time = { version = "0.5.1" }

embedded-hal-1 = { version = "1.0", package = "embedded-hal" }
embedded-hal-async = { version = "1.0.0", features = ["defmt-03"] }
embedded-io-async = { version = "0.7" }

cortex-m-rt = { version = "0.7" }

{% case template -%}
{% when "Blinky" -%}
{% when "GPIO In/Out" -%}
{% when "UART Echo" -%}
{% when "USB Device CDC" -%}
embassy-usb = { version = "0.6.0", features = ["defmt"] }
embassy-usb-driver = { version = "0.2.2", features = ["defmt"] }

{% when "USB Device HID Keyboard and Mouse" -%}
embassy-usb = { version = "0.6.0", features = ["defmt"] }
embassy-usb-driver = { version = "0.2.2", features = ["defmt"] }
usbd-hid = { version = "0.10.2" }

{% when "I2C SSD1306" -%}
ssd1306 = { version = "0.10.0", features = ["async"] }
embedded-graphics = { version = "0.8.2" }

{% when "I2C SSD1306 + DS3231" -%}
ssd1306 = { version = "0.10.0", features = ["async"] }
embedded-graphics = { version = "0.8.2" }
time = { version = "0.3.55", default-features = false } # no_std

{% when "Wi-Fi HTTP Client" -%}
embassy-net = { version = "0.9.1", features = [
    "icmp", "tcp", "udp", "raw", "dhcpv4", "medium-ethernet", "dns",
    "proto-ipv4", "proto-ipv6", "multicast",
    "defmt",
] }
reqwless = { git = "https://github.com/drogue-iot/reqwless",
    rev = "68f703dfc16e6f7f964b7238c922c0d433118872",
    features = ["defmt"],
}
serde = { version = "1.0.229", default-features = false, features = ["derive"] }
serde-json-core = { version = "0.5.1" }
cyw43 = { version = "0.7.0", features = ["defmt"] }
cyw43-pio = { version = "0.10.0" }

{% endcase -%}

[target.'cfg( target_arch = "arm" )'.dependencies]
panic-probe = { version = "1", features = ["print-defmt"] }

[target.'cfg( target_arch = "riscv32" )'.dependencies]
panic-halt = { version = "1.0.0" }

[target."thumbv6m-none-eabi".dependencies]
embassy-rp = { version = "0.10.0", features = [
    "time-driver", "critical-section-impl", "binary-info", "defmt", "unstable-pac",
    "rp2040",
] }

[target."thumbv8m.main-none-eabihf".dependencies]
embassy-rp = { version = "0.10.0", features = [
    "time-driver", "critical-section-impl", "binary-info", "defmt", "unstable-pac",
    "rp235xa",
] }

[target."riscv32imac-unknown-none-elf".dependencies]
embassy-rp = { version = "0.10.0", features = [
    "time-driver", "critical-section-impl", "binary-info", "defmt", "unstable-pac",
    "rp235xa",
] }
